{
  "name": "odot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "User-isolated todo application layer and REST API with Postgres RLS and Neon Auth.",
  "exports": {
    ".": "./dist/index.js",
    "./api": "./dist/api/index.js"
  },
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "start": "node dist/api/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@hono/zod-openapi": "^1.6.3",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "fractional-indexing": "^4.0.0",
    "hono": "^4.13.23",
    "jose": "^6.2.18",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^18.7.0-beta.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
